# Postgres (docker-compose levanta esto en el puerto 5433 del host)
DATABASE_URL="postgresql://orix:orix@localhost:5433/orixchat?schema=public"

# Firebase Admin: ruta al service account JSON (verifica los ID tokens del front)
FIREBASE_ADMIN_CREDENTIALS="./firebase-admin.json"

# Servidor
PORT=3000

# CORS: origen del front (Vite)
CORS_ORIGIN="http://localhost:5173"
