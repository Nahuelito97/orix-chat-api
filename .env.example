# Postgres (docker-compose levanta esto en el puerto 5433 del host)
DATABASE_URL="postgresql://orix:orix@localhost:5433/orixchat?schema=public"

# Firebase Admin: ruta al service account JSON (verifica los ID tokens del front)
FIREBASE_ADMIN_CREDENTIALS="./firebase-admin.json"

# Servidor
PORT=3000

# CORS: origen del front (Vite)
CORS_ORIGIN="http://localhost:5173"

# IA (OrixBot + asistente). Agnóstico al proveedor. Sin LLM_API_KEY, la IA queda off.
# LLM_PROVIDER: gemini | claude | openai   (openai cubre ChatGPT y DeepSeek)
LLM_PROVIDER="gemini"
LLM_API_KEY=
# LLM_MODEL (opcional; default por proveedor):
#   gemini → gemini-2.0-flash · claude → claude-opus-4-8 · openai → gpt-4o-mini
#   deepseek → deepseek-chat (con LLM_PROVIDER=openai + LLM_BASE_URL)
LLM_MODEL=
# LLM_BASE_URL (opcional; sólo para OpenAI-compatibles): DeepSeek = https://api.deepseek.com
LLM_BASE_URL=
